# ========================================
# NuraSkin Server - Production Environment
# ========================================

# --- Database ---
# REQUIRED: PostgreSQL connection string
DATABASE_URL=postgres://nuraskin_user:change_me_strong_password_min_32_chars@postgres:5432/nuraskin_prod

# --- Redis ---
# OPTIONAL: Redis connection string (defaults to redis://localhost:6379, should point to redis container)
REDIS_URL=redis://:change_me_strong_password_min_32_chars@redis:6379

# --- Server Config ---
# OPTIONAL: Port for the server to listen on (defaults to 4000)
PORT=4000

# --- JWT Auth ---
# REQUIRED: Secret key for signing JWT tokens (min 32 chars)
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
# OPTIONAL: JWT expiration time (defaults to 30d)
JWT_EXPIRES_IN=30d

# --- Telegram Bot ---
# REQUIRED: Telegram Bot token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# REQUIRED: Telegram Bot ID
TELEGRAM_BOT_ID=1234567890
# REQUIRED: Telegram Bot Username
TELEGRAM_BOT_USERNAME=your_bot_username
# OPTIONAL: Telegram Admin Chat ID for notifications
TELEGRAM_ADMIN_CHAT_ID=987654321

# --- Cloudinary (Media) ---
# OPTIONAL: Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=your_cloud_name
# OPTIONAL: Cloudinary API key
CLOUDINARY_API_KEY=your_api_key
# OPTIONAL: Cloudinary API secret
CLOUDINARY_API_SECRET=your_api_secret

# --- External APIs ---
# REQUIRED: OpenAI API Key for AI features
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# OPTIONAL: Juso API Key for address validation (Korea)
JUSO_API_KEY=your_juso_api_key
